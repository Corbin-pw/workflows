# testbed/config.env -- single source of truth for the virtual Slurm testbed.
# Every numbered script sources this. Edit here, never in the scripts.
#
# Host: Azure NC16as_T4_v3 -- Ubuntu 22.04 (kernel 6.8 azure), AMD EPYC 7V12
#       (zen2, AVX2, no AVX-512), 16 vCPU, ~108 GB RAM, 1x NVIDIA Tesla T4
#       (sm_75, 16 GB), 512 GB OS disk + ephemeral temp disk at /mnt.
# Nodes: Ubuntu 22.04 LXD system containers, mirroring the customer's cluster.

# ---- naming / network --------------------------------------------------------
CLUSTER_NAME="darpa-tb"
NODE_IMAGE="ubuntu:22.04"
LXD_BRIDGE="lxdbr-tb"                 # dedicated bridge, does not touch lxdbr0
LXD_SUBNET="10.42.0.1/24"             # host side of the bridge (Azure VNet is 10.1.0.0/24: no clash)
LXD_POOL="tb-pool"
LXD_POOL_DRIVER="dir"                 # dir = zero-setup on the OS disk
LXD_PROFILE="tb-node"
LXD_CHANNEL="5.21/stable"             # LTS; a preinstalled 4.x/5.0 snap is refreshed to this

CONTROLLER="tb-ctl"                   # slurmctld + login node (Activate "existing" cluster)
CONTROLLER_IP="10.42.0.10"
COMPUTES=("tb-c1" "tb-c2")
COMPUTE_IPS=("10.42.0.11" "10.42.0.12")

# ---- sizing (16 vCPU / ~108 GB on the host) -----------------------------------
# Limits are CAPS, not reservations: they may add up to more than the host has.
# Every node may use all 16 vCPUs. Slurm is told each compute node has
# SLURM_COMPUTE_CPUS, so the two compute nodes together advertise the host's 16.
# The controller is the default BUILD node of spack-builder (-j16 gcc/CUDA/ML
# builds), so it gets the most memory. Caps total ~100 GiB, leaving the host ~8.
CTL_CPUS=16;    CTL_MEM="52GiB"
COMPUTE_CPUS=16; COMPUTE_MEM="24GiB"
SLURM_COMPUTE_CPUS=8                  # advertised to Slurm per compute node
NODE_ROOT_SIZE="40GiB"                # per-container root quota (zfs/btrfs/lvm only; ignored on dir)

# ---- GPU ---------------------------------------------------------------------
# One T4, SHARED into both compute nodes (LXD allows one GPU in several
# containers). Slurm then counts one GPU per node, so two GPU jobs can land on
# the same physical card at once. Fine for functional tests; for one-GPU-only
# scheduling, set the second entry to "".
GPU_PCI=("0001:00:00.0" "0001:00:00.0")
NVIDIA_DRIVER_BRANCH=""               # empty = newest *-server branch ubuntu-drivers offers (>=570 for CUDA 12.8+)

# ---- Activate platform -------------------------------------------------------
ACTIVATE_URL="https://activate.parallel.works"   # your Activate URL; only used for reachability checks

# ---- storage (bind-mounted from the host into every node) ---------------------
# Spack + the CUDA/ML stack can reach 150-300 GB; the 512 GB OS disk holds it.
HOST_BASE="/srv/${CLUSTER_NAME}"
HOST_SOFTWARE="${HOST_BASE}/software" # -> /software  (Spack root target: /software/spack)
HOST_HOME="${HOST_BASE}/home"         # -> /home      (shared homes, like the customer's NFS)
# Azure's temp disk is fast but WIPED on deallocate/resize. Good for Spack build
# stages, never for installs. Shared into the nodes as /scratch. "" disables it.
HOST_SCRATCH="/mnt/${CLUSTER_NAME}-scratch"

# ---- cluster user (runs workflows, owns /software/spack) ---------------------
# Same name/UID/GID on every node. Match the customer's service account if known.
CLUSTER_USER="pwuser"
CLUSTER_UID=5001
CLUSTER_GID=5001
CLUSTER_USER_SUDO="yes"               # passwordless sudo inside the nodes (testbed convenience)

# ---- slurm -------------------------------------------------------------------
SLURM_SOURCE="apt"                    # apt = Ubuntu 22.04 archive (21.08.x). See README for matching the customer.
SLURM_PARTITION="compute"
# Module system on the nodes. The workflow writes Tcl modules; both of these read them.
MODULES_PKG="lmod"                    # lmod | environment-modules
